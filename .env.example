# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Real Database Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Meta Ads OAuth & Graph API Configuration
META_APP_ID="123456789012345"
META_APP_SECRET="your_meta_app_secret_here"
META_REDIRECT_URI="https://your-domain.com/api/meta/callback"

# URL base pública da aplicação ativa usada para geração de callbacks dinâmicos
APP_URL="https://seu-dominio.com"

# Credenciais de Banco do Projeto Supabase
VITE_SUPABASE_URL="https://sua-url-supabase.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publica-anon-key"

# Credenciais Oficiais do Meta Developer Application (Facebook Console)
META_APP_ID="seu_app_id_da_meta_aqui"
META_APP_SECRET="sua_chave_secreta_da_meta_aqui"
META_REDIRECT_URI="https://seu-dominio.com/api/meta/callback"